{
    "description": "Material Type with properties used to define particle ribbon.",
    "version": 3,
    "versionUpdates": [
        {
            "toVersion": 2,
            "actions": [
                {
                    "op": "setValue",
                    "name": "blend.opacityFactor",
                    "value": 1.0
                }
            ]
        },
        {
            "toVersion": 3,
            "actions": [
                {
                    "op": "setValue",
                    "name": "general.uvOffset",
                    "value": [
                        0.0,
                        0.0
                    ]
                },
                {
                    "op": "setValue",
                    "name": "general.uvTiling",
                    "value": [
                        1.0,
                        1.0
                    ]
                }
            ]
        }
    ],
    "propertyLayout": {
        "groups": [
            {
                "name": "emissive",
                "displayName": "Emissive",
                "description": "Properties to add light emission, independent of other lights in the scene."
            },
            {
                "name": "blend",
                "displayName": "Blend Mode",
                "description": "Properties for configuring the materials transparency."
            },
            {
                "name": "general",
                "displayName": "General Settings",
                "description": "General Settings."
            },
            {
                "name": "pattern",
                "displayName": "Pattern",
                "description": "A scrolling mask that thins the ribbon and warps its texture. u runs across the ribbon and v along it."
            },
            {
                "name": "dissolve",
                "displayName": "Dissolve",
                "description": "Lets the ribbon break up through the mask as it ages, instead of fading flat."
            },
            {
                "name": "ramp",
                "displayName": "Gradient",
                "description": "A colour gradient along the ribbon, across it or by the mask."
            },
            {
                "name": "edge",
                "displayName": "Edge, Core And Glow",
                "description": "Soft sides, a bright line down the middle, a rim band and an overall glow."
            },
            {
                "name": "distortion",
                "displayName": "Distortion",
                "description": "Warps the scene behind the ribbon like heat or glass, drawn by the particle distortion pass. Strength 0 turns the pass off for this material."
            }
        ],
        "properties": {
            "general": [
                {
                    "name": "DiffuseMap",
                    "displayName": "Diffuse Map",
                    "description": "Texture containing the base color for the ribbon.",
                    "type": "image",
                    "defaultValue": "Textures/OpenParticle/DefaultSpriteBaseColor.png",
                    "connection": {
                        "type": "shaderInput",
                        "name": "m_baseColorMap"
                    }
                },
                {
                    "name": "baseColorTint",
                    "displayName": "Base Color Tint",
                    "description": "Tints the base color texture and vertex color.",
                    "type": "Color",
                    "defaultValue": [
                        1.0,
                        1.0,
                        1.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_baseColorTint"
                    }
                },
                {
                    "name": "doubleSided",
                    "displayName": "Double-sided",
                    "description": "Whether to render back-faces or just front-faces.",
                    "type": "Bool",
                    "defaultValue": true
                },
                {
                    "name": "uvOffset",
                    "displayName": "UV Offset",
                    "description": "Offset applied to texture UV coordinates.",
                    "type": "Vector2",
                    "defaultValue": [
                        0.0,
                        0.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_uvOffset"
                    }
                },
                {
                    "name": "uvTiling",
                    "displayName": "UV Tiling",
                    "description": "Tiling (scale) applied to texture UV coordinates.",
                    "type": "Vector2",
                    "defaultValue": [
                        1.0,
                        1.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_uvTiling"
                    }
                }
            ],
            "pattern": [
                {
                    "name": "uvScroll",
                    "displayName": "Base Scroll",
                    "description": "Scrolls the base texture, in uv units per second. Along the ribbon is the second value.",
                    "type": "Vector2",
                    "defaultValue": [
                        0.0,
                        0.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_uvScroll"
                    }
                },
                {
                    "name": "maskMap",
                    "displayName": "Mask Map",
                    "description": "Grey or alpha pattern (red times alpha). Tiles and scrolls on its own.",
                    "type": "Image",
                    "defaultValue": "Textures/OpenParticle/RibbonNoise_greyscale.png",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_maskMap"
                    }
                },
                {
                    "name": "maskTiling",
                    "displayName": "Mask Tiling",
                    "description": "Repeats of the mask across the ribbon (first) and along it (second).",
                    "type": "Vector2",
                    "defaultValue": [
                        1.0,
                        1.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_maskTiling"
                    }
                },
                {
                    "name": "maskScroll",
                    "displayName": "Mask Scroll",
                    "description": "Scrolls the mask, in uv units per second. A negative second value flows from the head to the tail.",
                    "type": "Vector2",
                    "defaultValue": [
                        0.0,
                        0.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_maskScroll"
                    }
                },
                {
                    "name": "maskStrength",
                    "displayName": "Mask Strength",
                    "description": "How much the mask multiplies the opacity: 0 ignores it, 1 cuts the ribbon to the pattern.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_maskStrength"
                    }
                },
                {
                    "name": "warpStrength",
                    "displayName": "Warp Strength",
                    "description": "How far the mask pushes the base texture around, in uv units. 0 turns the warp off.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 2.0,
                    "softMax": 0.5,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_warpStrength"
                    }
                }
            ],
            "dissolve": [
                {
                    "name": "amount",
                    "displayName": "Amount",
                    "description": "0 fades the ribbon with its age as before. 1 moves the fade into the mask, so the ribbon breaks up instead.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_dissolve"
                    }
                },
                {
                    "name": "softness",
                    "displayName": "Softness",
                    "description": "Width of the soft edge of the breaking-up pattern.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.15,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_dissolveSoftness"
                    }
                }
            ],
            "ramp": [
                {
                    "name": "map",
                    "displayName": "Ramp Map",
                    "description": "Gradient read left to right; the colour and alpha multiply the ribbon.",
                    "type": "Image",
                    "defaultValue": "Textures/OpenParticle/RibbonWhite.png",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_rampMap"
                    }
                },
                {
                    "name": "mix",
                    "displayName": "Mix",
                    "description": "0 ignores the ramp, 1 applies it fully.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_rampMix"
                    }
                },
                {
                    "name": "source",
                    "displayName": "Source",
                    "description": "What picks the point on the ramp.",
                    "type": "Enum",
                    "enumValues": [
                        "Length",
                        "Width",
                        "Mask"
                    ],
                    "defaultValue": "Length",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_rampSource"
                    }
                }
            ],
            "edge": [
                {
                    "name": "softness",
                    "displayName": "Edge Softness",
                    "description": "Fades the sides of the ribbon, 0 keeps them hard and 1 fades from the middle.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_edgeSoftness"
                    }
                },
                {
                    "name": "startFade",
                    "displayName": "Start Fade",
                    "description": "Fades the end of the ribbon where v is 0, as a fraction of its length: the oldest particle in Ribbon mode, the newest in Trail mode. 0 keeps it hard.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 0.5,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_startFade"
                    }
                },
                {
                    "name": "endFade",
                    "displayName": "End Fade",
                    "description": "Fades the end of the ribbon where v is 1, as a fraction of its length: the newest particle in Ribbon mode (the weapon end of a trail), the oldest in Trail mode. 0 keeps it hard.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 0.5,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_endFade"
                    }
                },
                {
                    "name": "coreColor",
                    "displayName": "Core Color",
                    "description": "Colour of the bright line down the middle of the ribbon.",
                    "type": "Color",
                    "defaultValue": [
                        1.0,
                        1.0,
                        1.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_coreColor"
                    }
                },
                {
                    "name": "coreIntensity",
                    "displayName": "Core Intensity",
                    "description": "Strength of the core line; above 1 it blooms. 0 turns it off.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 20.0,
                    "softMax": 6.0,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_coreIntensity"
                    }
                },
                {
                    "name": "corePower",
                    "displayName": "Core Sharpness",
                    "description": "Higher values squeeze the core into a thinner line.",
                    "type": "Float",
                    "min": 0.1,
                    "max": 32.0,
                    "softMax": 8.0,
                    "defaultValue": 3.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_corePower"
                    }
                },
                {
                    "name": "rimColor",
                    "displayName": "Rim Color",
                    "description": "Colour of the solid band along the side of the ribbon.",
                    "type": "Color",
                    "defaultValue": [
                        1.0,
                        1.0,
                        1.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_rimColor"
                    }
                },
                {
                    "name": "rimIntensity",
                    "displayName": "Rim Intensity",
                    "description": "Brightness and opacity of the rim band, like the bright leading edge of a slash. 0 turns it off.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 20.0,
                    "softMax": 6.0,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_rimIntensity"
                    }
                },
                {
                    "name": "rimWidth",
                    "displayName": "Rim Width",
                    "description": "Width of the rim band as a fraction of the ribbon width.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.12,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_rimWidth"
                    }
                },
                {
                    "name": "rimSide",
                    "displayName": "Rim Side",
                    "description": "Which side of the ribbon carries the rim. Start is u = 0 and End is u = 1; which one is the blade tip depends on the ribbon width axis.",
                    "type": "Enum",
                    "enumValues": [
                        "Both",
                        "Start",
                        "End"
                    ],
                    "defaultValue": "End",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_rimSide"
                    }
                },
                {
                    "name": "rimOpacity",
                    "displayName": "Rim Opacity",
                    "description": "Scales the rim on its own, on top of the fades it already follows. 0 hides it without touching the body.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_rimOpacity"
                    }
                },
                {
                    "name": "rimDissolve",
                    "displayName": "Rim Dissolve",
                    "description": "How much the rim breaks up and disappears with the Dissolve setting, through the same mask as the body. 0 keeps the rim solid until its age fade ends.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_rimDissolve"
                    }
                },
                {
                    "name": "glow",
                    "displayName": "Glow",
                    "description": "Multiplies the whole ribbon colour; above 1 it blooms.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 20.0,
                    "softMax": 6.0,
                    "defaultValue": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_glow"
                    }
                }
            ],
            "distortion": [
                {
                    "name": "strength",
                    "displayName": "Strength",
                    "description": "Largest warp in pixels at 1080p; 0 disables the warp and its draw.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 300.0,
                    "softMax": 120.0,
                    "defaultValue": 0.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_distortStrength"
                    }
                },
                {
                    "name": "swirl",
                    "displayName": "Swirl",
                    "description": "0 pushes the scene along the ribbon gradient, 1 turns it around the streaks.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.4,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_distortSwirl"
                    }
                },
                {
                    "name": "chromatic",
                    "displayName": "Chromatic Split",
                    "description": "Splits the colour channels of the warped scene for a glassy fringe.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.1,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_distortChromatic"
                    }
                }
            ],
            "blend": [
                {
                    "name": "mode",
                    "displayName": "Blend Mode",
                    "description": "Indicates the general approach how transparency is to be applied",
                    "type": "Enum",
                    "enumValues": [
                        "Opaque",
                        "Cutout",
                        "Blended",
                        "Additive",
                        "Subtractive",
                        "Modulate"
                    ],
                    "defaultValue": "Blended",
                    "connection": {
                        "type": "shaderOption",
                        "name": "o_blendMode"
                    }
                },
                {
                    "name": "factor",
                    "displayName": "AlphaCutoff",
                    "description": "Factor for cutout threshold and blending",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.5,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_alphaCutoff"
                    }
                },
                {
                    "name": "opacityFactor",
                    "displayName": "Opacity",
                    "description": "Controls overall opacity for transparent blend modes.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_opacityFactor"
                    }
                }
            ],
            "emissive": [
                {
                    "name": "enable",
                    "displayName": "Enable",
                    "description": "Enable the emissive group",
                    "type": "Bool",
                    "defaultValue": false
                },
                {
                    "name": "unit",
                    "displayName": "Units",
                    "description": "The photometric units of the Intensity property.",
                    "type": "Enum",
                    "enumValues": [
                        "Ev100"
                    ],
                    "defaultValue": "Ev100"
                },
                {
                    "name": "color",
                    "displayName": "Color",
                    "description": "Color is displayed as sRGB but the values are stored as linear color.",
                    "type": "Color",
                    "defaultValue": [
                        1.0,
                        1.0,
                        1.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_emissiveColor"
                    }
                },
                {
                    "name": "intensity",
                    "displayName": "Intensity",
                    "description": "The amount of energy emitted.",
                    "type": "Float",
                    "defaultValue": 4,
                    "min": -10,
                    "max": 20,
                    "softMin": -6,
                    "softMax": 16
                },
                {
                    "name": "textureMap",
                    "displayName": "Texture",
                    "description": "Texture for defining emissive area.",
                    "type": "Image",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_emissiveMap"
                    }
                },
                {
                    "name": "useTexture",
                    "displayName": "Use Texture",
                    "description": "Whether to use the texture.",
                    "type": "Bool",
                    "defaultValue": true
                },
                {
                    "name": "textureMapUv",
                    "displayName": "UV",
                    "description": "Emissive map UV set",
                    "type": "Enum",
                    "enumIsUv": true,
                    "defaultValue": "Tiled",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_emissiveMapUvIndex"
                    }
                }
            ]
        }
    },
    "shaders": [
        {
            "file": "Shaders/OpenParticle/ParticleRibbon.shader",
            "tag": "ForwardPass"
        },
        {
            "file": "Shaders/OpenParticle/ParticleRibbonDistortion.shader",
            "tag": "RibbonDistortion"
        }
    ],
    "functors": [
        {
            "type": "ConvertEmissiveUnit",
            "args": {
                "intensityProperty": "emissive.intensity",
                "lightUnitProperty": "emissive.unit",
                "shaderInput": "m_emissiveIntensity",
                "ev100Index": 0,
                "nitIndex": 1,
                "ev100MinMax": [
                    -10,
                    20
                ],
                "nitMinMax": [
                    0.001,
                    100000.0
                ],
                "shaderParameters": [
                    {
                        "name": "m_emissiveIntensity",
                        "type": "float"
                    }
                ]
            }
        },
        {
            "type": "Lua",
            "args": {
                "file": "Shaders/OpenParticle/Particle_HandleBlendMode.lua"
            }
        },
        {
            "type": "Lua",
            "args": {
                "file": "Shaders/OpenParticle/Particle_RibbonDistortionEnable.lua"
            }
        },
        {
            "type": "Lua",
            "args": {
                "file": "Shaders/OpenParticle/Particle_EmissiveState.lua"
            }
        },
        {
            "type": "Lua",
            "args": {
                "file": "Materials/OpenParticle/Types/StandardPBR_HandleOpacityDoubleSided.lua"
            }
        }
    ],
    "uvNameMap": {
        "UV0": "Tiled",
        "UV1": "Unwrapped"
    }
}
