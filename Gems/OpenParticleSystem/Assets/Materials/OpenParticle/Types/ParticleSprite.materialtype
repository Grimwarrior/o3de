{
    "description": "Material Type with properties used to define particle sprite.",
    "version": 3,
    "versionUpdates": [
        {
            "toVersion": 2,
            "actions": [
                {
                    "op": "setValue",
                    "name": "blend.opacityFactor",
                    "value": 1.0
                }
            ]
        },
        {
            "toVersion": 3,
            "actions": [
                {
                    "op": "setValue",
                    "name": "general.uvOffset",
                    "value": [
                        0.0,
                        0.0
                    ]
                },
                {
                    "op": "setValue",
                    "name": "general.uvTiling",
                    "value": [
                        1.0,
                        1.0
                    ]
                }
            ]
        }
    ],
    "propertyLayout": {
        "groups": [
            {
                "name": "emissive",
                "displayName": "Emissive",
                "description": "Properties to add light emission, independent of other lights in the scene."
            },
            {
                "name": "blend",
                "displayName": "Blend Mode",
                "description": "Properties for configuring the materials transparency."
            },
            {
                "name": "general",
                "displayName": "General Settings",
                "description": "General Settings."
            },
            {
                "name": "erosion",
                "displayName": "Alpha Erosion",
                "description": "alpha erosion: the alpha is boosted, then everything under a threshold that rises with particle age is cut, so thin parts burn away first."
            }
        ],
        "properties": {
            "general": [
                {
                    "name": "DiffuseMap",
                    "displayName": "Diffuse Map",
                    "description": "Texture containing the base color and opacity for the particle.",
                    "type": "image",
                    "defaultValue": "Textures/OpenParticle/DefaultSpriteBaseColor.png",
                    "connection": {
                        "type": "shaderInput",
                        "name": "m_baseColorMap"
                    }
                },
                {
                    "name": "baseColorTint",
                    "displayName": "Base Color Tint",
                    "description": "Tints the base color texture and vertex color.",
                    "type": "Color",
                    "defaultValue": [
                        1.0,
                        1.0,
                        1.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_baseColorTint"
                    }
                },
                {
                    "name": "doubleSided",
                    "displayName": "Double-sided",
                    "description": "Whether to render back-faces or just front-faces.",
                    "type": "Bool",
                    "defaultValue": true
                },
                {
                    "name": "uvOffset",
                    "displayName": "UV Offset",
                    "description": "Offset applied to texture UV coordinates.",
                    "type": "Vector2",
                    "defaultValue": [
                        0.0,
                        0.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_uvOffset"
                    }
                },
                {
                    "name": "uvTiling",
                    "displayName": "UV Tiling",
                    "description": "Tiling (scale) applied to texture UV coordinates.",
                    "type": "Vector2",
                    "defaultValue": [
                        1.0,
                        1.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_uvTiling"
                    }
                },
                {
                    "name": "brightness",
                    "displayName": "Brightness",
                    "description": "Multiplies the final colour, above 1 for HDR glow that blooms.",
                    "type": "Float",
                    "defaultValue": 1.0,
                    "min": 0.0,
                    "softMax": 50.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_brightness"
                    }
                },
                {
                    "name": "anchor",
                    "displayName": "Anchor",
                    "description": "Where the particle sits on a camera facing sprite, -1 to 1 per axis: (0, 0) centre, (0, -1) bottom edge so the sprite grows upward from the particle.",
                    "type": "Vector2",
                    "defaultValue": [ 0.0, 0.0 ],
                    "min": -1.0,
                    "max": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_anchor"
                    }
                },
                {
                    "name": "upAxis",
                    "displayName": "Up Axis",
                    "description": "Camera Pos facing only: the axis the sprite stands along while it turns to face the camera. World Z keeps it upright; an entity axis follows the host's rotation, e.g. Entity Y runs flames along a blade.",
                    "type": "Enum",
                    "enumValues": [ "World Z", "Entity X", "Entity Y", "Entity Z" ],
                    "defaultValue": "World Z",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_upAxis"
                    }
                }
            ],
            "erosion": [
                {
                    "name": "enable",
                    "displayName": "Enable",
                    "description": "Turns alpha erosion on.",
                    "type": "Bool",
                    "defaultValue": false,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionEnable"
                    }
                },
                {
                    "name": "alphaMultiplier",
                    "displayName": "Alpha Multiplier",
                    "description": "Boosts texture alpha x particle alpha before the threshold; high values give hard edged shapes.",
                    "type": "Float",
                    "defaultValue": 20.0,
                    "min": 0.0,
                    "softMax": 50.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionAlphaMultiplier"
                    }
                },
                {
                    "name": "thresholdStart",
                    "displayName": "Threshold At Birth",
                    "description": "Boosted alpha below this is cut when the particle spawns (FXR alphaThreshold / 255).",
                    "type": "Float",
                    "defaultValue": 0.125,
                    "min": 0.0,
                    "softMax": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionThresholdStart"
                    }
                },
                {
                    "name": "thresholdEnd",
                    "displayName": "Threshold At Death",
                    "description": "Threshold at the end of the particle's life; higher than the start erodes the shape as it ages.",
                    "type": "Float",
                    "defaultValue": 0.25,
                    "min": 0.0,
                    "softMax": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionThresholdEnd"
                    }
                },
                {
                    "name": "softness",
                    "displayName": "Edge Softness",
                    "description": "Width of the fade above the threshold; small values give crisp edges.",
                    "type": "Float",
                    "defaultValue": 0.25,
                    "min": 0.001,
                    "softMax": 2.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionSoftness"
                    }
                },
                {
                    "name": "noiseMap",
                    "displayName": "Noise Map",
                    "description": "Tiling noise (red channel) sampled twice with different scroll speeds.",
                    "type": "Image",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionNoiseMap"
                    }
                },
                {
                    "name": "noiseTiling",
                    "displayName": "Noise Tiling",
                    "description": "Noise UV scale across the quad (FXR layer scale).",
                    "type": "Vector2",
                    "defaultValue": [ 0.15, 0.15 ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionNoiseTiling"
                    }
                },
                {
                    "name": "noiseScroll1",
                    "displayName": "Noise Scroll 1",
                    "description": "UV per second of the first noise sample.",
                    "type": "Vector2",
                    "defaultValue": [ 0.0, 0.25 ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionNoiseScroll1"
                    }
                },
                {
                    "name": "noiseScroll2",
                    "displayName": "Noise Scroll 2",
                    "description": "UV per second of the second noise sample.",
                    "type": "Vector2",
                    "defaultValue": [ 0.0, 0.125 ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionNoiseScroll2"
                    }
                },
                {
                    "name": "noiseBoost",
                    "displayName": "Noise Boost",
                    "description": "Multiplies the averaged noise before it is clamped to 1.",
                    "type": "Float",
                    "defaultValue": 4.0,
                    "min": 0.0,
                    "softMax": 40.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionNoiseColorBoost"
                    }
                },
                {
                    "name": "noiseColorStrength",
                    "displayName": "Noise On Colour",
                    "description": "How much the noise darkens the colour (0 = off).",
                    "type": "Float",
                    "defaultValue": 0.0,
                    "min": 0.0,
                    "max": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionNoiseColorStrength"
                    }
                },
                {
                    "name": "noiseAlphaStrength",
                    "displayName": "Noise On Alpha",
                    "description": "How much the noise eats into the alpha before the threshold (0 = off).",
                    "type": "Float",
                    "defaultValue": 0.0,
                    "min": 0.0,
                    "max": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_erosionNoiseAlphaStrength"
                    }
                }
            ],
            "blend": [
                {
                    "name": "mode",
                    "displayName": "Blend Mode",
                    "description": "Indicates the general approach how transparency is to be applied",
                    "type": "Enum",
                    "enumValues": [
                        "Opaque",
                        "Cutout",
                        "Blended",
                        "Additive",
                        "Subtractive",
                        "Modulate"
                    ],
                    "defaultValue": "Blended",
                    "connection": {
                        "type": "shaderOption",
                        "name": "o_blendMode"
                    }
                },
                {
                    "name": "factor",
                    "displayName": "AlphaCutoff",
                    "description": "Factor for cutout threshold and blending",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 0.5,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_alphaCutoff"
                    }
                },
                {
                    "name": "opacityFactor",
                    "displayName": "Opacity",
                    "description": "Controls overall opacity for transparent blend modes.",
                    "type": "Float",
                    "min": 0.0,
                    "max": 1.0,
                    "defaultValue": 1.0,
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_opacityFactor"
                    }
                }
            ],
            "emissive": [
                {
                    "name": "enable",
                    "displayName": "Enable",
                    "description": "Enable the emissive group",
                    "type": "Bool",
                    "defaultValue": false
                },
                {
                    "name": "unit",
                    "displayName": "Units",
                    "description": "The photometric units of the Intensity property.",
                    "type": "Enum",
                    "enumValues": [
                        "Ev100"
                    ],
                    "defaultValue": "Ev100"
                },
                {
                    "name": "color",
                    "displayName": "Color",
                    "description": "Color is displayed as sRGB but the values are stored as linear color.",
                    "type": "Color",
                    "defaultValue": [
                        1.0,
                        1.0,
                        1.0
                    ],
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_emissiveColor"
                    }
                },
                {
                    "name": "intensity",
                    "displayName": "Intensity",
                    "description": "The amount of energy emitted.",
                    "type": "Float",
                    "defaultValue": 4,
                    "min": -10,
                    "max": 20,
                    "softMin": -6,
                    "softMax": 16
                },
                {
                    "name": "textureMap",
                    "displayName": "Texture",
                    "description": "Texture for defining emissive area.",
                    "type": "Image",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_emissiveMap"
                    }
                },
                {
                    "name": "useTexture",
                    "displayName": "Use Texture",
                    "description": "Whether to use the texture.",
                    "type": "Bool",
                    "defaultValue": true
                },
                {
                    "name": "textureMapUv",
                    "displayName": "UV",
                    "description": "Emissive map UV set",
                    "type": "Enum",
                    "enumIsUv": true,
                    "defaultValue": "Tiled",
                    "connection": {
                        "type": "ShaderInput",
                        "name": "m_emissiveMapUvIndex"
                    }
                }
            ]
        }
    },
    "shaders": [
        {
            "file": "Shaders/OpenParticle/ParticleSprite.shader",
            "tag": "ForwardPass"
        }
    ],
    "functors": [
        {
            "type": "ConvertEmissiveUnit",
            "args": {
                "intensityProperty": "emissive.intensity",
                "lightUnitProperty": "emissive.unit",
                "shaderInput": "m_emissiveIntensity",
                "ev100Index": 0,
                "nitIndex": 1,
                "ev100MinMax": [
                    -10,
                    20
                ],
                "nitMinMax": [
                    0.001,
                    100000.0
                ],
                "shaderParameters": [
                    {
                        "name": "m_emissiveIntensity",
                        "type": "float"
                    }
                ]
            }
        },
        {
            "type": "Lua",
            "args": {
                "file": "Shaders/OpenParticle/Particle_HandleBlendMode.lua"
            }
        },
        {
            "type": "Lua",
            "args": {
                "file": "Shaders/OpenParticle/Particle_EmissiveState.lua"
            }
        },
        {
            "type": "Lua",
            "args": {
                "file": "Materials/OpenParticle/Types/StandardPBR_HandleOpacityDoubleSided.lua"
            }
        }
    ],
    "uvNameMap": {
        "UV0": "Tiled",
        "UV1": "Unwrapped"
    }
}
