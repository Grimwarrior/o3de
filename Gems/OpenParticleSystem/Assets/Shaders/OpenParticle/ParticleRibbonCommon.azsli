#pragma once

#include <viewsrg_all.srgi>
#include <scenesrg_all.srgi>

#define PIPELINE_HAS_PASS_SRG 0

#include <Atom/Features/SrgSemantics.azsli>
#include <Atom/RPI/ShaderResourceGroups/DefaultDrawSrg.azsli>
#include <Atom/Features/PBR/DefaultObjectSrg.azsli>
#include <OpenParticle/ParticleCommon.azsli>
#include <OpenParticle/ParticleAlphaUtils.azsli>
#include <OpenParticle/ParticleEmissiveInput.azsli>

// Shared by the forward and the distortion shader of the ribbon material; the material layout has to be declared identically in both.
ShaderResourceGroup MaterialSrg : SRG_PerMaterial
{
    Texture2D m_baseColorMap;
    float m_alphaCutoff;

    float3      m_baseColorTint;
    float       m_opacityFactor;
    float2      m_uvOffset;
    float2      m_uvTiling;
    float2      m_uvScroll;
    float       m_glow;

    // Pattern: a mask texture that scrolls, thins the ribbon and can warp the base texture.
    Texture2D   m_maskMap;
    float2      m_maskTiling;
    float2      m_maskScroll;
    float       m_maskStrength;
    float       m_warpStrength;

    // Dissolve: the ribbon breaks up through the mask as its colour alpha (its age) falls.
    float       m_dissolve;
    float       m_dissolveSoftness;

    // Ramp: a gradient that recolours the ribbon along its length, across its width or by the mask.
    Texture2D   m_rampMap;
    float       m_rampMix;
    uint        m_rampSource;

    // Edge and core: a soft fade towards the sides and a bright line down the middle.
    float       m_edgeSoftness;
    float       m_startFade;
    float       m_endFade;
    float3      m_coreColor;
    float       m_coreIntensity;
    float       m_corePower;

    // Rim: a bright solid band along one side or both, like the leading edge of a slash.
    float3      m_rimColor;
    float       m_rimIntensity;
    float       m_rimWidth;
    uint        m_rimSide;
    float       m_rimOpacity;
    float       m_rimDissolve;

    // Distortion: warps the scene behind the ribbon (only read by the distortion shader).
    float       m_distortStrength;
    float       m_distortSwirl;
    float       m_distortChromatic;

    float3      m_emissiveColor;
    float       m_emissiveIntensity;
    Texture2D   m_emissiveMap;
    uint        m_emissiveMapUvIndex;

    Sampler m_sampler
    {
        MaxAnisotropy = 16;
        AddressU = Wrap;
        AddressV = Wrap;
        AddressW = Wrap;
    };

    Sampler m_clampSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
}

struct VertexInput
{
    float4 position : POSITION;
    float4 color : COLOR;
    float4 uv0 : UV0;
};

struct VertexOutput
{
    float4 position : SV_Position;
    float4 color : COLOR;
    float2 uv : UV0;
    float lengthFraction : UV1;
};

VertexOutput MainVS(in VertexInput input)
{
    VertexOutput output;
    float3 cameraDir = normalize(ViewSrg::m_worldPosition - input.position.xyz);

    float4 worldPosition = float4(input.position.xyz, 1.0);
    output.position = mul(ViewSrg::m_viewProjectionMatrix, worldPosition);
    output.color = input.color;
    output.uv = input.uv0.xy;
    output.lengthFraction = input.uv0.z;
    return output;
}

struct PixelOutput
{
     float4 color : SV_Target0;
};

// The ribbon uv: u runs across the width (0 to 1), v along the length (a texture repeat per Tiling Distance when that is set). lengthFraction is 0 to 1 along
// the ribbon in any case, so the ramp and the end fades keep working with Tiling Distance. Returns the colour before the blend mode touches it.
float4 ShadeRibbon(in VertexOutput input)
{
    const float sceneTime = SceneSrg::m_time;
    const float2 uv = input.uv;
    const float across = abs(uv.x * 2.0 - 1.0);

    // The mask pattern scrolls on its own and warps the base texture.
    const float2 maskUv = uv * MaterialSrg::m_maskTiling + MaterialSrg::m_maskScroll * sceneTime;
    const float4 maskSample = MaterialSrg::m_maskMap.Sample(MaterialSrg::m_sampler, maskUv);
    const float mask = saturate(maskSample.r * maskSample.a);

    float2 baseUv = uv * MaterialSrg::m_uvTiling + MaterialSrg::m_uvOffset + MaterialSrg::m_uvScroll * sceneTime;
    baseUv += (mask - 0.5) * MaterialSrg::m_warpStrength;

    float4 color = input.color * MaterialSrg::m_baseColorMap.Sample(MaterialSrg::m_sampler, baseUv);
    color.rgb *= MaterialSrg::m_baseColorTint;

    // Dissolve lets the age (the colour alpha) eat the ribbon through the mask instead of fading it flat: the alpha moves into the threshold.
    const float soft = max(MaterialSrg::m_dissolveSoftness, 0.001);
    const float threshold = lerp(-soft, (1.0 - input.color.a) * (1.0 + soft) - soft, MaterialSrg::m_dissolve);
    color.a = lerp(color.a, color.a / max(input.color.a, 0.0001), MaterialSrg::m_dissolve);
    const float dissolveKeep = smoothstep(threshold, threshold + soft, mask);
    color.a *= dissolveKeep;

    color.a *= lerp(1.0, mask, MaterialSrg::m_maskStrength);

    // Ramp along the length (0), across the width (1) or by the mask (2).
    float rampCoord = input.lengthFraction;
    if (MaterialSrg::m_rampSource == 1)
    {
        rampCoord = uv.x;
    }
    else if (MaterialSrg::m_rampSource == 2)
    {
        rampCoord = mask;
    }
    const float4 ramp = MaterialSrg::m_rampMap.Sample(MaterialSrg::m_clampSampler, float2(saturate(rampCoord), 0.5));
    color.rgb *= lerp(float3(1.0, 1.0, 1.0), ramp.rgb, MaterialSrg::m_rampMix);
    color.a *= lerp(1.0, ramp.a, MaterialSrg::m_rampMix);

    // Soft sides, and a bright core line down the middle that fades with the ribbon.
    if (MaterialSrg::m_edgeSoftness > 0.0001)
    {
        color.a *= 1.0 - smoothstep(1.0 - MaterialSrg::m_edgeSoftness, 1.0, across);
    }
    // Soft ends: 0 at the oldest particle of the ribbon and 1 at the newest in Ribbon mode (the other way round in Trail mode).
    const float ends = smoothstep(0.0, max(MaterialSrg::m_startFade, 0.0001), input.lengthFraction)
        * smoothstep(0.0, max(MaterialSrg::m_endFade, 0.0001), 1.0 - input.lengthFraction);
    color.a *= ends;
    const float core = pow(saturate(1.0 - across), max(MaterialSrg::m_corePower, 0.01));
    color.rgb += MaterialSrg::m_coreColor * (core * MaterialSrg::m_coreIntensity);

    // The body takes the overall opacity here so the rim, which is added next, can follow it on its own terms.
    color.a *= MaterialSrg::m_opacityFactor;

    // The rim is a solid band along the side. It fades with the ribbon: the age fade, the soft ends, the overall opacity and the dissolve (Rim Dissolve breaks it
    // up through the same mask as the body), and Rim Opacity scales it on top.
    if (MaterialSrg::m_rimIntensity > 0.0001)
    {
        float side = across;
        if (MaterialSrg::m_rimSide == 1)
        {
            side = uv.x;
        }
        else if (MaterialSrg::m_rimSide == 2)
        {
            side = 1.0 - uv.x;
        }
        const float rimFade = ends * input.color.a * lerp(1.0, dissolveKeep, MaterialSrg::m_rimDissolve)
            * MaterialSrg::m_rimOpacity * MaterialSrg::m_opacityFactor;
        const float rim = smoothstep(1.0 - max(MaterialSrg::m_rimWidth, 0.001), 1.0, side) * rimFade;
        color.rgb += MaterialSrg::m_rimColor * (rim * MaterialSrg::m_rimIntensity);
        color.a = saturate(color.a + rim * saturate(MaterialSrg::m_rimIntensity));
    }

    color.rgb *= MaterialSrg::m_glow;

    const float2 emissiveUv = input.uv;
    const float3 emissiveValue = GetEmissiveInput(MaterialSrg::m_emissiveMap, MaterialSrg::m_sampler, emissiveUv,
        MaterialSrg::m_emissiveIntensity, MaterialSrg::m_emissiveColor.rgb, o_emissiveEnabled, o_emissive_useTexture);
    color.rgb += emissiveValue;
    return color;
}
