#include "ParticleRibbonCommon.azsli"

PixelOutput MainPS(in VertexOutput input)
{
    PixelOutput output;
    float4 color = ShadeRibbon(input);

    // Additive and subtractive blending ignore alpha, so the fade has to be in the colour.
    switch (o_blendMode)
    {
    case BlendMode::Additive:
    case BlendMode::Subtractive:
        color.rgb *= color.a;
        break;
    default:
        break;
    }

    output.color = color;
    CheckClipping(output.color.a, MaterialSrg::m_alphaCutoff);
    return output;
}
