// Template of the Particle Ribbon output node of Material Canvas. The generated blocks are filled from the graph; as it stands the template is a plain ribbon shader.

#include <viewsrg_all.srgi>
#include <scenesrg_all.srgi>

#include <Atom/Features/SrgSemantics.azsli>
#include <Atom/RPI/ShaderResourceGroups/DefaultDrawSrg.azsli>
#include <Atom/Features/PBR/DefaultObjectSrg.azsli>
#include <OpenParticle/ParticleCommon.azsli>
#include <OpenParticle/ParticleAlphaUtils.azsli>

// O3DE_GENERATED_INCLUDES_BEGIN
// O3DE_GENERATED_INCLUDES_END

ShaderResourceGroup MaterialSrg : SRG_PerMaterial
{
    // Keeps the group from being empty while a graph has no material inputs.
    float m_graphPlaceholder;

    // O3DE_GENERATED_MATERIAL_SRG_BEGIN
    // O3DE_GENERATED_MATERIAL_SRG_END
}

// O3DE_GENERATED_CLASSES_BEGIN
// O3DE_GENERATED_CLASSES_END

// O3DE_GENERATED_FUNCTIONS_BEGIN
// O3DE_GENERATED_FUNCTIONS_END

struct VertexInput
{
    float4 position : POSITION;
    float4 color : COLOR;
    float4 uv0 : UV0;
};

struct VertexOutput
{
    float4 position : SV_Position;
    float4 color : COLOR;
    float2 uv : UV0;
    float lengthFraction : UV1;
};

VertexOutput MainVS(in VertexInput input)
{
    VertexOutput output;
    output.position = mul(ViewSrg::m_viewProjectionMatrix, float4(input.position.xyz, 1.0));
    output.color = input.color;
    output.uv = input.uv0.xy;
    output.lengthFraction = input.uv0.z;
    return output;
}

struct PixelOutput
{
    float4 color : SV_Target0;
};

PixelOutput MainPS(in VertexOutput input)
{
    PixelOutput output;

    // What the Ribbon Vertex node reads: u across the ribbon, v along it, the 0 to 1 length fraction and the particle colour.
    const float2 O3DE_RIBBON_UV = input.uv;
    const float O3DE_RIBBON_LENGTH = input.lengthFraction;
    const float4 O3DE_RIBBON_COLOR = input.color;
    // The standard UV node asks for a uv set; the ribbon has only one.
    #define O3DE_MC_UV(index) O3DE_RIBBON_UV

    // O3DE_GENERATED_INSTRUCTIONS_BEGIN: inBaseColor, inAlpha, inEmissive
    float3 inBaseColor = {1.0, 1.0, 1.0};
    float inAlpha = 1.0;
    float3 inEmissive = {0.0, 0.0, 0.0};
    // O3DE_GENERATED_INSTRUCTIONS_END

    #undef O3DE_MC_UV

    // The particle colour carries the age fade, so it multiplies the graph.
    float4 color = float4(inBaseColor, inAlpha) * input.color;
    color.rgb += inEmissive;

    // Additive and subtractive blending ignore alpha, so the fade has to be in the colour.
    switch (o_blendMode)
    {
    case BlendMode::Additive:
    case BlendMode::Subtractive:
        color.rgb *= color.a;
        break;
    default:
        break;
    }

    output.color = color;
    CheckClipping(output.color.a, 0.5);
    return output;
}
